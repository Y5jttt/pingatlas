# 行尾策略：仓库内一律 LF（Windows 上编辑也不会写坏 shell 脚本）
* text=auto eol=lf
*.sh    text eol=lf
*.service text eol=lf
*.timer   text eol=lf
*.go    text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.bat   text eol=crlf
*.exe   binary
*.ico   binary
*.png   binary
